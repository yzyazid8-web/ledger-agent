# SEC EDGAR requires a descriptive User-Agent with a contact email
SEC_USER_AGENT="ledger-agent your.email@example.com"

# LLM providers (free tiers)
GROQ_API_KEY=
GEMINI_API_KEY=

# Observability (Langfuse Cloud, Hobby plan)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
