# SEC EDGAR exige un User-Agent descriptif avec un e-mail de contact
SEC_USER_AGENT="ledger-agent your.email@example.com"

# Fournisseurs de LLM (offres gratuites)
GROQ_API_KEY=
GEMINI_API_KEY=

# Suivi en production (Langfuse Cloud, offre Hobby) : actif seulement si les deux clés sont
# renseignées, et seulement pour l'API (jamais pendant les évaluations)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Part des questions envoyées (1.0 : toutes)
LANGFUSE_SAMPLE_RATE=1.0

# Chemins locaux et journalisation
DATA_DIR=
LOG_LEVEL=INFO

# Réseau : forcer IPv4 si la route IPv6 vers Groq est cassée (erreurs ConnectError)
FORCE_IPV4=false

# Questions par visiteur et par heure sur le site public (0 = pas de limite)
API_QUESTIONS_PER_HOUR=20
